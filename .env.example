# Base de datos (Neon pooled URL en prod; PG local en dev)
DATABASE_URL=
# Secreto aleatorio >= 32 bytes (openssl rand -base64 32)
AUTH_SECRET=
# URL pública de la app (se usa para verificar Origin/CSRF)
APP_URL=http://localhost:3000
# Bearer para /api/cron/reminders
CRON_SECRET=
# Opcional: sha256 hex de un token pc_... de Eddie (bootstrap)
EDDIE_API_TOKEN_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
# Orígenes CORS separados por coma (vacío = sin CORS)
CORS_ALLOWED_ORIGINS=
# Solo para el seed
OWNER_EMAIL=
OWNER_PASSWORD=
DEFAULT_TIMEZONE=America/Santo_Domingo
